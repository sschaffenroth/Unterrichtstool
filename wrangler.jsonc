{
  // Name muss dem Worker-Namen in Cloudflare entsprechen.
  "name": "unterrichtstool",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none" },
  "durable_objects": {
    "bindings": [{ "name": "RAUM", "class_name": "Raum" }]
  },
  // SQLite-Durable-Objects gibt es auch im Free-Plan
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Raum"] }]
}
